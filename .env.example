# Never commit your real credentials.
GEMINI_API_KEY=
# Override this with a model available to your account.
VLOGII_MODEL=gemini-3.8-flash
# Speech is recognized separately from original audio, using the same Gemini key.
VLOGII_SPEECH_MODEL=gemini-3.5-transcribe
VLOGII_SPEECH_LANGUAGE=auto
# Video understanding / planning only; dedicated Transcribe has no thinking parameter.
VLOGII_THINKING=medium
# CLI interface language when running non-interactively.
VLOGII_LANGUAGE=zh
# Optional absolute executable paths; ffmpeg-full is preferred automatically on macOS.
# VLOGII_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# VLOGII_FFPROBE=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# Optional font override for your caption language.
# VLOGII_FONT=/absolute/path/to/a/font.ttf
