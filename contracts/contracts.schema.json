{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auto Vlog data contracts 1.0.0",
  "description": "Backend validation schema. AI providers need a compatible payload-only schema adapter. Fixtures contain illustrative asset references, not media.",
  "oneOf": [
    {
      "$ref": "#/$defs/assets"
    },
    {
      "$ref": "#/$defs/project_config"
    },
    {
      "$ref": "#/$defs/edit_plan"
    },
    {
      "$ref": "#/$defs/timeline"
    },
    {
      "$ref": "#/$defs/edit_request"
    },
    {
      "$ref": "#/$defs/transcript"
    }
  ],
  "$defs": {
    "Title": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "eyebrow",
        "headline",
        "tagline"
      ],
      "additionalProperties": false
    },
    "Output": {
      "type": "object",
      "properties": {
        "width": {
          "enum": [
            1280,
            720
          ]
        },
        "height": {
          "enum": [
            720,
            1280
          ]
        },
        "fps": {
          "const": 30
        },
        "encoding_profile": {
          "const": "mp4_h264_aac"
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "encoding_profile"
      ],
      "additionalProperties": false
    },
    "DurationPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "target"
            },
            "target_seconds": {
              "enum": [
                20,
                30,
                60
              ]
            },
            "tolerance_frames": {
              "const": 30
            }
          },
          "required": [
            "mode",
            "target_seconds",
            "tolerance_frames"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "natural"
            },
            "target_seconds": {
              "type": "null"
            },
            "tolerance_frames": {
              "const": 0
            }
          },
          "required": [
            "mode",
            "target_seconds",
            "tolerance_frames"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "output": {
          "$ref": "#/$defs/Output"
        },
        "duration_policy": {
          "$ref": "#/$defs/DurationPolicy"
        },
        "style_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "style_revision": {
          "type": "integer",
          "minimum": 1
        },
        "mood_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title_overrides": {
          "type": "object",
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "tagline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "warmth_override": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "music_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "voice_enabled": {
          "type": "boolean"
        },
        "subtitles_enabled": {
          "type": "boolean"
        },
        "excluded_clip_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "creation_brief": {
          "type": "object",
          "properties": {
            "text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference_image_asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "text",
            "reference_image_asset_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "output",
        "duration_policy",
        "style_id",
        "style_revision",
        "mood_id",
        "title_overrides",
        "warmth_override",
        "music_asset_id",
        "voice_enabled",
        "subtitles_enabled",
        "excluded_clip_ids",
        "creation_brief"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "storage_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,511}$"
            },
            "origin": {
              "enum": [
                "upload",
                "bundled",
                "generated"
              ]
            },
            "kind": {
              "const": "video"
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0.001
            },
            "display_width": {
              "type": "integer",
              "minimum": 1
            },
            "display_height": {
              "type": "integer",
              "minimum": 1
            },
            "rotation_degrees": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "has_audio": {
              "type": "boolean"
            }
          },
          "required": [
            "asset_id",
            "storage_key",
            "origin",
            "kind",
            "duration_seconds",
            "display_width",
            "display_height",
            "rotation_degrees",
            "has_audio"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "storage_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,511}$"
            },
            "origin": {
              "enum": [
                "upload",
                "bundled",
                "generated"
              ]
            },
            "kind": {
              "const": "audio"
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0.001
            }
          },
          "required": [
            "asset_id",
            "storage_key",
            "origin",
            "kind",
            "duration_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "storage_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,511}$"
            },
            "origin": {
              "enum": [
                "upload",
                "bundled",
                "generated"
              ]
            },
            "kind": {
              "const": "image"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "asset_id",
            "storage_key",
            "origin",
            "kind",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "storage_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,511}$"
            },
            "origin": {
              "enum": [
                "upload",
                "bundled",
                "generated"
              ]
            },
            "kind": {
              "const": "font"
            }
          },
          "required": [
            "asset_id",
            "storage_key",
            "origin",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PlanShot": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "clip_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "source_window": {
          "type": "object",
          "properties": {
            "in_seconds": {
              "type": "number",
              "minimum": 0
            },
            "out_seconds": {
              "type": "number",
              "minimum": 0.001
            }
          },
          "required": [
            "in_seconds",
            "out_seconds"
          ],
          "additionalProperties": false
        },
        "preferred_duration_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 60
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "speech_sentence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "shot_id",
        "clip_id",
        "source_window",
        "preferred_duration_seconds",
        "importance",
        "section_id",
        "speech_sentence_ids"
      ],
      "additionalProperties": false
    },
    "PlanPayload": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/Title"
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanShot"
          },
          "minItems": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "section_id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "title",
        "shots",
        "sections"
      ],
      "additionalProperties": false
    },
    "Rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "TextStyle": {
      "type": "object",
      "properties": {
        "font_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "font_size_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "stroke_width_px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "stroke_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "font_asset_id",
        "font_size_px",
        "color",
        "align",
        "stroke_width_px",
        "stroke_color"
      ],
      "additionalProperties": false
    },
    "Animation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "none"
            },
            "in_frames": {
              "const": 0
            },
            "out_frames": {
              "const": 0
            }
          },
          "required": [
            "type",
            "in_frames",
            "out_frames"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "fade"
            },
            "in_frames": {
              "type": "integer",
              "minimum": 1
            },
            "out_frames": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "in_frames",
            "out_frames"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Framing": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focus_x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "focus_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "mode",
        "background_color",
        "focus_x",
        "focus_y"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cut"
            },
            "duration_frames": {
              "const": 0
            }
          },
          "required": [
            "type",
            "duration_frames"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "dissolve"
            },
            "duration_frames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": [
            "type",
            "duration_frames"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Shot": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "clip_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "source_in_seconds": {
          "type": "number",
          "minimum": 0
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "framing": {
          "$ref": "#/$defs/Framing"
        },
        "transition_in": {
          "$ref": "#/$defs/Transition"
        }
      },
      "required": [
        "shot_id",
        "clip_id",
        "source_in_seconds",
        "start_frame",
        "duration_frames",
        "framing",
        "transition_in"
      ],
      "additionalProperties": false
    },
    "AudioTrack": {
      "type": "object",
      "properties": {
        "track_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "kind": {
          "enum": [
            "bgm",
            "source_audio",
            "narration"
          ]
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_in_seconds": {
          "type": "number",
          "minimum": 0
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "fade_in_frames": {
          "type": "integer",
          "minimum": 0
        },
        "fade_out_frames": {
          "type": "integer",
          "minimum": 0
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "offset_frame": {
                "type": "integer",
                "minimum": 0
              },
              "delta_db": {
                "type": "number",
                "minimum": -60,
                "maximum": 0
              }
            },
            "required": [
              "offset_frame",
              "delta_db"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "track_id",
        "kind",
        "asset_id",
        "shot_id",
        "source_in_seconds",
        "start_frame",
        "duration_frames",
        "gain_db",
        "fade_in_frames",
        "fade_out_frames",
        "envelope"
      ],
      "additionalProperties": false
    },
    "Overlay": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "overlay_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "start_frame": {
              "type": "integer",
              "minimum": 0
            },
            "end_frame": {
              "type": "integer",
              "minimum": 1
            },
            "z_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "rect": {
              "$ref": "#/$defs/Rect"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "animation": {
              "$ref": "#/$defs/Animation"
            },
            "kind": {
              "const": "text"
            },
            "role": {
              "enum": [
                "title_eyebrow",
                "title_headline",
                "title_tagline",
                "chapter"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "text_style": {
              "$ref": "#/$defs/TextStyle"
            }
          },
          "required": [
            "overlay_id",
            "start_frame",
            "end_frame",
            "z_index",
            "rect",
            "opacity",
            "animation",
            "kind",
            "role",
            "text",
            "text_style"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "overlay_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "start_frame": {
              "type": "integer",
              "minimum": 0
            },
            "end_frame": {
              "type": "integer",
              "minimum": 1
            },
            "z_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "rect": {
              "$ref": "#/$defs/Rect"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "animation": {
              "$ref": "#/$defs/Animation"
            },
            "kind": {
              "const": "image"
            },
            "role": {
              "enum": [
                "decoration",
                "sticker"
              ]
            },
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "fit": {
              "const": "contain"
            }
          },
          "required": [
            "overlay_id",
            "start_frame",
            "end_frame",
            "z_index",
            "rect",
            "opacity",
            "animation",
            "kind",
            "role",
            "asset_id",
            "fit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Subtitle": {
      "type": "object",
      "properties": {
        "subtitle_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "source_audio_track_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "source_sentence_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "text_style": {
          "$ref": "#/$defs/TextStyle"
        }
      },
      "required": [
        "subtitle_id",
        "source_audio_track_id",
        "source_sentence_id",
        "start_frame",
        "end_frame",
        "text",
        "rect",
        "text_style"
      ],
      "additionalProperties": false
    },
    "StyleSnapshot": {
      "type": "object",
      "properties": {
        "preset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "preset_revision": {
          "type": "integer",
          "minimum": 1
        },
        "mood_id": {
          "anyOf": [
            {
              "type": "string",
