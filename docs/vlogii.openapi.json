  "components": {
    "schemas": {
      "Body_upload_api_vlogii_projects_post": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          },
          "orientation": {
            "type": "string",
            "title": "Orientation",
            "default": "portrait"
          },
          "color": {
            "type": "string",
            "title": "Color",
            "default": "sdr"
          }
        },
        "type": "object",
        "required": [
          "name",
          "files"
        ],
        "title": "Body_upload_api_vlogii_projects_post"
      },
      "EditRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "exclude_clip_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Exclude Clip Ids"
          },
          "warmth": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Warmth"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EditRequest"
      },
      "GenerateRequest": {
        "properties": {
          "direction": {
            "type": "string",
            "maxLength": 2000,
            "title": "Direction",
            "default": "A calm chronological diary of my day."
          },
          "target_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 5.0,
            "title": "Target Seconds",
            "default": 30
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "complete",
              "failed"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "generate",
                  "edit"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "message"
        ],
        "title": "JobState"
      },
      "ProjectView": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "clips": {
            "items": {
              "$ref": "#/components/schemas/WebClip"
            },
            "type": "array",
            "title": "Clips"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobState"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionHistory"
              },
              {
                "type": "null"
              }
            ]
          },
          "video_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Url"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "clips",
          "settings",
          "job",
          "latest",
          "video_url",
          "duration_seconds"
        ],
        "title": "ProjectView"
      },
      "Settings": {
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 3840.0,
            "minimum": 64.0,
            "title": "Width",
            "default": 1080
          },
          "height": {
            "type": "integer",
            "maximum": 3840.0,
            "minimum": 64.0,
            "title": "Height",
            "default": 1920
          },
          "fps": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Fps",
            "default": 30
          },
          "color": {
            "type": "string",
            "enum": [
              "auto",
              "sdr",
              "hlg"
            ],
            "title": "Color",
            "default": "auto"
          },
          "encoder": {
            "type": "string",
            "enum": [
              "auto",
              "software"
            ],
            "title": "Encoder",
            "default": "auto"
          },
          "warmth": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Warmth",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionHistory": {
        "properties": {
          "cut": {
            "type": "string",
            "title": "Cut"
          },
          "history": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cut",
          "history"
        ],
        "title": "VersionHistory"
      },
      "WebClip": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "duration": {
            "type": "number",
            "title": "Duration"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "duration"
        ],
        "title": "WebClip"
      }
    }
  }
}
