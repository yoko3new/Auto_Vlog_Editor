  "components": {
    "schemas": {
      "Appearance": {
        "properties": {
          "font": {
            "type": "string",
            "enum": [
              "default",
              "noto-sans",
              "noto-serif",
              "ma-shan-zheng",
              "zcool-xiaowei",
              "caveat",
              "playfair-display",
              "tinos",
              "eb-garamond",
              "libre-baskerville",
              "lora",
              "cinzel",
              "cormorant-garamond",
              "montserrat",
              "source-sans-3"
            ],
            "title": "Font",
            "default": "default"
          },
          "music": {
            "type": "string",
            "enum": [
              "uploaded",
              "none",
              "auto",
              "holizna-dreams",
              "holizna-day-jobs",
              "holizna-dancing",
              "holizna-deja-vu",
              "holizna-childhood",
              "holizna-advertisements"
            ],
            "title": "Music",
            "default": "none"
          },
          "music_volume": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Music Volume",
            "default": 0.16
          },
          "duck_music": {
            "type": "boolean",
            "title": "Duck Music",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Appearance"
      },
      "Body_add_music_api_vlogii_projects__name__music_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_add_music_api_vlogii_projects__name__music_post"
      },
      "Body_upload_api_vlogii_projects_post": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          },
          "orientation": {
            "type": "string",
            "title": "Orientation",
            "default": "portrait"
          },
          "color": {
            "type": "string",
            "title": "Color",
            "default": "sdr"
          }
        },
        "type": "object",
        "required": [
          "name",
          "files"
        ],
        "title": "Body_upload_api_vlogii_projects_post"
      },
      "Chapter": {
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "minimum": 0.0,
            "title": "End"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "clip_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Clip Ids"
          },
          "kind": {
            "type": "string",
            "enum": [
              "scene",
              "hook",
              "body",
              "end_card",
              "cover"
            ],
            "title": "Kind",
            "default": "scene"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "title",
          "summary"
        ],
        "title": "Chapter"
      },
      "ChapterEdit": {
        "properties": {
          "chapter_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Chapter Index"
          },
          "action": {
            "type": "string",
            "enum": [
              "remove",
              "remove_range",
              "speed",
              "instruction"
            ],
            "title": "Action"
          },
          "start": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 8.0,
                "minimum": 0.25
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          },
          "instruction": {
            "type": "string",
            "maxLength": 1000,
            "title": "Instruction",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chapter_index",
          "action"
        ],
        "title": "ChapterEdit"
      },
      "Cover": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "subtitle": {
            "type": "string",
            "maxLength": 160,
            "title": "Subtitle",
            "default": ""
          },
          "kicker": {
            "type": "string",
            "maxLength": 80,
            "title": "Kicker",
            "default": ""
          },
          "font": {
            "type": "string",
            "enum": [
              "default",
              "noto-sans",
              "noto-serif",
              "ma-shan-zheng",
              "zcool-xiaowei",
              "caveat",
              "playfair-display",
              "tinos",
              "eb-garamond",
              "libre-baskerville",
              "lora",
              "cinzel",
              "cormorant-garamond",
              "montserrat",
              "source-sans-3"
            ],
            "title": "Font",
            "default": "noto-serif"
          },
          "style": {
            "type": "string",
            "enum": [
              "clean",
              "editorial",
              "playful"
            ],
            "title": "Style",
            "default": "clean"
          },
          "frame_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Frame Seconds",
            "default": 0
          },
          "show_intro": {
            "type": "boolean",
            "title": "Show Intro",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "Cover"
      },
      "CoverPreviewRequest": {
        "properties": {
          "cover": {
            "$ref": "#/components/schemas/Cover"
          },
          "base_cut": {
            "type": "string",
            "pattern": "^cut_\\d{3,}$",
            "title": "Base Cut"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cover",
          "base_cut"
        ],
        "title": "CoverPreviewRequest"
      },
      "EditRequest": {
        "properties": {
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cover"
              },
              {
                "type": "null"
              }
            ]
          },
          "chapter_edits": {
            "items": {
              "$ref": "#/components/schemas/ChapterEdit"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Chapter Edits"
          },
          "base_cut": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^cut_\\d{3,}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Cut"
          },
          "included_clip_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 50,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Included Clip Ids"
          },
          "video_filter": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "bright",
                  "warm",
                  "cool_white"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Filter"
          },
          "appearance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Appearance"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "exclude_clip_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Exclude Clip Ids"
          },
          "warmth": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Warmth"
          },
          "remove_ranges": {
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Remove Ranges"
          },
